# Shell launcher scripts must use LF line endings to work on Linux/macOS
*.sh text eol=lf
hve.sh text eol=lf
hve/setup-hve.sh text eol=lf

# The SDK lock is asserted to be LF-only, so it must not pick up CRLF on Windows checkouts.
hve/copilot-sdk.lock text eol=lf

# Container build assets are consumed by Linux builders (ACR Tasks)
src/infra/azure/data-verify/Dockerfile text eol=lf

# Prompt sources are read verbatim by CI shell steps and the Python loader,
# so they must not pick up CRLF regardless of the contributor's core.autocrlf.
.github/prompts/**/*.md text eol=lf

# csv.writer always emits CRLF, and cq/tests/test_surface_export.py compares the
# regenerated bytes against these files, so they must check out as CRLF on Linux too.
hve-dev/*.csv text eol=crlf
