{
  "management_files": {
    "requirements": "docs/requirements-definition.md",
    "requirements_dir": "docs/requirements",
    "catalog": "docs/catalog.md",
    "id_registry": "docs/id-registry.md",
    "run_history": "docs/run-history.md",
    "ledger": "tests/system/ledger.json",
    "manual_tests": "docs/manual-tests.md",
    "integrations": "docs/integrations.md"
  },
  "base_branch": "main",
  "work": {
    "dir": "work",
    "retention_days": 14
  },
  "credits": {
    "_note": "AI クレジットの推定。run-state.py finish が --credits なしのとき、作業役（task）の呼び出し 1 回を、モデルの倍率で数えて run-history に「推定」として記録する。倍率は契約・課金表に合わせて書く（未記載のモデルは default_multiplier）。進行役自身の呼び出しは hook から見えないため含まない。",
    "default_multiplier": 1,
    "model_multipliers": {}
  },
  "limits": {
    "_note": "1 run の時間（時間単位）。max_hours_default は run_options に max_hours がないときの値、max_hours_cap は指定値を切り詰める上限。夜間に長く回すなら max_hours_cap を引き上げる。reserve_minutes は工程 6 のために残す時間で、残りがこれを切ると新しい項目を始めない。",
    "max_hours_default": 2.5,
    "max_hours_cap": 3,
    "reserve_minutes": 30
  },
  "worktree_share": {
    "_note": "worktree に作らず、主の作業ツリーの実体へのリンク（Windows は junction）にするディレクトリ。npm ci の並列実行（各 45 分）を避ける。enabled を false にすると共有しない。",
    "enabled": true,
    "dirs": ["node_modules"]
  },
  "verify": {
    "timeout_sec": 1800,
    "commands": [
      {
        "name": "toolkit-unit",
        "run": "python -m pytest -q tests/toolkit/test_clean_work.py"
      },
      {
        "name": "studio-ui",
        "run": "python -m pytest -q EABK-Studio/tests",
        "slow": true
      }
    ]
  },
  "gates": {
    "enabled": true,
    "subagent_verify": {
      "implementer": ["--quick"],
      "test-designer": ["--docs-only"],
      "rd-author": ["--docs-only"]
    },
    "subagent_verify_max_blocks": 3,
    "agent_stop_max_blocks": 40,
    "enforce_conductor_edit_scope": true
  }
}
