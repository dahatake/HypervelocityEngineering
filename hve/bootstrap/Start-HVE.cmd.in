@echo off
setlocal EnableExtensions DisableDelayedExpansion
rem FR-LOCAL-SURFACE-04: native Windows 11 x64 entry, rendered by the ZIP builder.
set "RC=0"
set "STAGE=platform"
set "REASON=unsupported-windows-version"
set "OWN_LOCK="
set "OWN_WORK="
set "WORK_DIR="
set "LOCK_STAGE="
set "ZIP_PATH="
set "PROBE_DIR="
set "INSTALL_STABLE_PWSH="
set "WINGET_EXE="
set "RANDOM="
set "PUSHED="
set "ERRORLEVEL="
set "SYSTEM_NATIVE=%SystemRoot%\System32"
if exist "%SystemRoot%\Sysnative\cmd.exe" set "SYSTEM_NATIVE=%SystemRoot%\Sysnative"
set "ComSpec=%SYSTEM_NATIVE%\cmd.exe"
if /I not "%PROCESSOR_ARCHITECTURE%"=="AMD64" if /I not "%PROCESSOR_ARCHITEW6432%"=="AMD64" goto fail_arch
set "OS_MAJOR="
set "OS_BUILD="
for /f "tokens=4-7 delims=[]. " %%A in ('ver') do set "OS_MAJOR=%%A"& set "OS_BUILD=%%C"
if not "%OS_MAJOR%"=="10" goto fail_platform
if not defined OS_BUILD goto fail_platform
for /f "delims=0123456789" %%B in ("%OS_BUILD%") do goto fail_platform
if %OS_BUILD% LSS 22000 goto fail_platform
set "OS_INSTALLATION_TYPE="
for /f "tokens=1,2,*" %%A in ('%SYSTEM_NATIVE%\reg.exe query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v InstallationType 2^>nul') do if "%%A"=="InstallationType" if "%%B"=="REG_SZ" set "OS_INSTALLATION_TYPE=%%C"
if not "%OS_INSTALLATION_TYPE%"=="Client" goto fail_platform
set "ROOT=%~dp0"
set "ROOT=%ROOT:~0,-1%"
if "%ROOT:~0,2%"=="\\" goto fail_platform
pushd "%SYSTEM_NATIVE%" || exit /b 2
set "PUSHED=1"
set "CRITICAL_LIST=%ROOT%\hve-bootstrap-critical.sha256"
set "EXPECTED_CRITICAL_LIST_SHA256={{CRITICAL_LIST_SHA256}}"
set "HASH_PATH=%CRITICAL_LIST%"
call :hash_file
if /I not "%ACTUAL_SHA256%"=="%EXPECTED_CRITICAL_LIST_SHA256%" goto fail_list_hash
for %%D in ("%ROOT%" "%ROOT%\hve" "%ROOT%\hve\bootstrap" "%ROOT%\hve\gui" "%ROOT%\.hve-bootstrap" "%CRITICAL_LIST%") do (
    set "CHECK_PATH=%%~D"
    call :plain_path
    if errorlevel 1 goto fail_unsafe_path
)
set "BOOTSTRAP_DIR=%ROOT%\.hve-bootstrap"
set "LOCK_DIR=%BOOTSTRAP_DIR%\bootstrap.lock"
set "OWNER_FILE=%LOCK_DIR%\owner.txt"
if not exist "%BOOTSTRAP_DIR%" mkdir "%BOOTSTRAP_DIR%" 2>nul
if not exist "%BOOTSTRAP_DIR%\." goto fail_lock_prepare
if not exist "%LOCK_DIR%" goto prepare_attempt
call :check_owner
if errorlevel 2 goto fail_lock_unknown
if errorlevel 1 goto fail_lock_live
rem Only one reaper may claim an observed dead owner. Recheck after claiming.
set "STALE_PID=%LOCK_PID%"
mkdir "%LOCK_DIR%\reap.lock" 2>nul
if errorlevel 1 goto fail_lock_unknown
call :check_owner
if errorlevel 1 goto fail_lock_unknown
if not "%LOCK_PID%"=="%STALE_PID%" goto fail_lock_unknown
call :lock_has_links
if errorlevel 1 goto fail_lock_unknown
call :lock_contents
if errorlevel 1 goto fail_lock_unknown
set "RETIRE_NAME=retired-stale-%RANDOM%"
set "RETIRE_DIR=%BOOTSTRAP_DIR%\%RETIRE_NAME%"
call :retire_lock
if errorlevel 1 goto fail_lock_unknown
set "OWN_LOCK="
echo BOOTSTRAP_STAGE stage=lock reason=lock-owner-stale retry=true
:prepare_attempt
rem Unpublished staging may be abandoned safely. Never publish a pending owner.
set "ATTEMPT=%RANDOM%-%RANDOM%-%RANDOM%"
set "WORK_DIR=%BOOTSTRAP_DIR%\attempt-%ATTEMPT%"
set "LOCK_STAGE=%BOOTSTRAP_DIR%\lock-%ATTEMPT%"
set "RETIRE_NAME=retired-%ATTEMPT%"
set "RETIRE_DIR=%BOOTSTRAP_DIR%\%RETIRE_NAME%"
set "OWNER_RECORD=%WORK_DIR%\owner.txt"
set "CHECK_PATH=%WORK_DIR%"
call :plain_path
if errorlevel 1 goto fail_unsafe_path
mkdir "%WORK_DIR%" 2>nul
if errorlevel 1 goto fail_lock_prepare
set "OWN_WORK=1"
set "CRITICAL_COUNT=0"
for /f "tokens=1 delims==" %%V in ('set HVE_CRITICAL_SEEN_ 2^>nul') do set "%%V="
"%SYSTEM_NATIVE%\findstr.exe" /R /V /X /C:"[0-9a-f][0-9a-f]*  [A-Za-z0-9_./-][A-Za-z0-9_./-]*" "%CRITICAL_LIST%" >nul 2>nul
if not errorlevel 1 goto fail_file_hash
if errorlevel 2 goto fail_file_hash
for /f "usebackq delims=" %%L in ("%CRITICAL_LIST%") do (
    set "CRITICAL_LINE=%%L"
    call :critical_file
    if errorlevel 1 goto fail_file_hash
    set /a CRITICAL_COUNT+=1 >nul
)
call :critical_set
if errorlevel 1 goto fail_file_hash
rem Clear child-only Python/pip overrides without printing their values.
for /f "tokens=1 delims==" %%V in ('set PYTHON 2^>nul') do set "%%V="
for /f "tokens=1 delims==" %%V in ('set PIP_ 2^>nul') do set "%%V="
set "VIRTUAL_ENV="
set "__PYVENV_LAUNCHER__="
set "PYTHONNOUSERSITE=1"
set "PYTHONSAFEPATH=1"
set "PYTHONDONTWRITEBYTECODE=1"
set "PSModulePath="
set "VENV_PY=%ROOT%\.venv\Scripts\python.exe"
set "VERIFY_JSON=%WORK_DIR%\verifier.json"
set "VERIFY_STATE=%WORK_DIR%\verifier-state.txt"
if not exist "%VENV_PY%" goto resolve_pwsh
for %%D in ("%ROOT%\.venv" "%ROOT%\.venv\Scripts" "%VENV_PY%") do (
    set "CHECK_PATH=%%~D"
    call :plain_path
    if errorlevel 1 goto fail_unsafe_path
)
rem CPython's venv redirector is a transient parent, not the lock owner.
rem Walk only that bounded native ancestor chain and require the real cmd image.
"%VENV_PY%" -I -c "exec('import os,sys,datetime,ctypes as c\nk=c.WinDLL(\'kernel32\',use_last_error=True); nt=c.WinDLL(\'ntdll\'); k.OpenProcess.restype=c.c_void_p\nn=os.getppid(); owner=None\nfor _ in range(4):\n h=k.OpenProcess(0x1000,False,n)\n if not h: raise OSError(\'owner-unverifiable\')\n try:\n  image=c.create_unicode_buffer(32768); size=c.c_ulong(32768)\n  if not k.QueryFullProcessImageNameW(c.c_void_p(h),0,image,c.byref(size)): raise OSError(\'owner-unverifiable\')\n  if os.path.normcase(image.value)==os.path.normcase(sys.argv[2]):\n   times=[c.c_ulonglong() for _ in range(4)]\n   if not k.GetProcessTimes(c.c_void_p(h),*[c.byref(v) for v in times]): raise OSError(\'owner-unverifiable\')\n   owner=n; started=datetime.datetime.fromtimestamp(times[0].value/10000000-11644473600,datetime.timezone.utc); break\n  if os.path.basename(image.value).lower() not in (\'python.exe\',\'pythonw.exe\'): raise OSError(\'owner-unverifiable\')\n  info=(c.c_void_p*6)()\n  if nt.NtQueryInformationProcess(c.c_void_p(h),0,c.byref(info),c.sizeof(info),None): raise OSError(\'owner-unverifiable\')\n  n=info[5]\n finally: k.CloseHandle(c.c_void_p(h))\nif owner is None: raise OSError(\'owner-unverifiable\')\np=sys.argv[1]; t=started.strftime(\'%%Y-%%m-%%dT%%H:%%M:%%SZ\'); open(p+\'.tmp\',\'w\',encoding=\'ascii\').write(\'PID=\'+str(owner)+chr(10)+\'STARTED_UTC=\'+t+chr(10)); os.replace(p+\'.tmp\',p)')" "%OWNER_RECORD%" "%SystemRoot%\System32\cmd.exe" >nul 2>nul
if errorlevel 1 goto fail_lock_unknown
call :acquire_lock
if errorlevel 1 goto fail_lock_unknown
"%VENV_PY%" -I -m hve.bootstrap_verify --root "%ROOT%" --json > "%VERIFY_JSON%" 2>nul
set "VERIFIER_EXIT=%ERRORLEVEL%"
rem Consume the T13 schema validator, not a second readiness verification.
"%VENV_PY%" -I -c "import json,sys; from hve.bootstrap_verify import validate_payload; p=json.load(sys.stdin,object_pairs_hook=lambda pairs: dict(pairs) if len(dict(pairs))==len(pairs) else None); e=validate_payload(p,reported_exit=int(sys.argv[1])); sys.exit(2) if e else None; print(p['state'])" "%VERIFIER_EXIT%" < "%VERIFY_JSON%" > "%VERIFY_STATE%" 2>nul
if errorlevel 1 goto fail_payload
set "INITIAL_STATE="
set /p "INITIAL_STATE=" < "%VERIFY_STATE%"
if "%INITIAL_STATE%"=="ready" goto launch_entrypoint
if "%INITIAL_STATE%"=="needs_version_decision" goto launch_entrypoint
if "%INITIAL_STATE%"=="needs_setup" goto resolve_pwsh
set "RC=%VERIFIER_EXIT%"
set "STAGE=verifier"
set "REASON=blocked"
goto finalize

:resolve_pwsh
set "RUNTIME_CHECK=%ROOT%\hve\bootstrap\windows-pwsh-runtime-check.ps1"
set "PWSH_EXE="
for /f "delims=" %%P in ('%SYSTEM_NATIVE%\where.exe pwsh.exe 2^>nul') do (
    set "CANDIDATE=%%P"
    call :try_pwsh
)
if defined PWSH_EXE goto launch_powershell
set "WINGET_EXE="
for /f "delims=" %%W in ('%SYSTEM_NATIVE%\where.exe winget.exe 2^>nul') do if not defined WINGET_EXE set "WINGET_EXE=%%W"
if not defined WINGET_EXE goto portable_pwsh
"%WINGET_EXE%" --version >nul 2>nul
if errorlevel 1 goto portable_pwsh
set "INSTALL_STABLE_PWSH=1"

:portable_pwsh
set "ZIP_PATH=%WORK_DIR%\PowerShell-7.6.5-win-x64.zip"
set "PROBE_DIR=%WORK_DIR%\powershell-runtime"
set "DOWNLOAD_URL={{POWERSHELL_WINDOWS_X64_URL}}"
set "EXPECTED_SHA256={{POWERSHELL_WINDOWS_X64_SHA256}}"
set "POWERSHELL_VERSION={{POWERSHELL_VERSION}}"
if not exist "%SYSTEM_NATIVE%\curl.exe" goto fail_native
if not exist "%SYSTEM_NATIVE%\tar.exe" goto fail_native
mkdir "%PROBE_DIR%" 2>nul
if errorlevel 1 goto fail_download
set "FETCH_EXIT="
set "FETCH_HTTP="
set "FETCH_SCHEME="
set "FINAL_HOST="
rem Only four metadata tokens are consumed; never save a signed effective URL.
rem Allowed final origins: https://github.com/ https://release-assets.githubusercontent.com/
for /f "tokens=1-4 delims=/ " %%A in ('%SYSTEM_NATIVE%\curl.exe --disable --silent --fail --location --max-redirs 5 --connect-timeout 20 --max-time 300 --proto "=https" --proto-redir "=https" --write-out "%%{exitcode} %%{http_code} %%{url_effective}" --output "%ZIP_PATH%" "%DOWNLOAD_URL%" 2^>nul') do (
    set "FETCH_EXIT=%%A"
    set "FETCH_HTTP=%%B"
    set "FETCH_SCHEME=%%C"
    set "FINAL_HOST=%%D"
)
if not "%FETCH_EXIT%"=="0" goto fail_download
if not "%FETCH_HTTP%"=="200" goto fail_download
if not "%FETCH_SCHEME%"=="https:" goto fail_redirect
if not "%FINAL_HOST%"=="github.com" if not "%FINAL_HOST%"=="release-assets.githubusercontent.com" goto fail_redirect
if not exist "%ZIP_PATH%" goto fail_download
for %%F in ("%ZIP_PATH%") do if %%~zF EQU 0 goto fail_checksum
set "HASH_PATH=%ZIP_PATH%"
call :hash_file
if /I not "%ACTUAL_SHA256%"=="%EXPECTED_SHA256%" goto fail_checksum
"%SYSTEM_NATIVE%\tar.exe" -xf "%ZIP_PATH%" -C "%PROBE_DIR%"
if errorlevel 1 goto fail_extract
if not exist "%PROBE_DIR%\pwsh.exe" goto fail_extract
"%PROBE_DIR%\pwsh.exe" -NoLogo -NoProfile -File "%RUNTIME_CHECK%" -ExpectedVersion "%POWERSHELL_VERSION%" -ExpectedExecutable "%PROBE_DIR%\pwsh.exe" -OwnerPath "%OWNER_RECORD%" >nul 2>nul
if errorlevel 1 goto fail_runtime
set "PWSH_EXE=%PROBE_DIR%\pwsh.exe"

:launch_powershell
call :acquire_lock
if errorlevel 1 goto fail_lock_unknown
rem No shared OS install before publishing a fully verifiable owner atomically.
if defined INSTALL_STABLE_PWSH "%WINGET_EXE%" install --id Microsoft.PowerShell -e --source winget --scope user --accept-source-agreements --accept-package-agreements --silent
if defined INSTALL_STABLE_PWSH if errorlevel 1 goto fail_package_manager
for %%P in ("%PWSH_EXE%") do set "PATH=%%~dpP;%PATH%"
"%PWSH_EXE%" -NoLogo -NoProfile -File "%ROOT%\Start-HVE.ps1" -Root "%ROOT%" -ExpectedCriticalListHash "%EXPECTED_CRITICAL_LIST_SHA256%"
set "RC=%ERRORLEVEL%"
set "STAGE=powershell"
set "REASON=child-exit"
goto finalize

:launch_entrypoint
rem No Yes on either the ready path or the existing version-decision path.
set "HVE_BOOTSTRAP_ENTRY=%ROOT%\hve.cmd"
"%SYSTEM_NATIVE%\cmd.exe" /d /v:off /s /c ""%HVE_BOOTSTRAP_ENTRY%" gui"
set "RC=%ERRORLEVEL%"
set "STAGE=gui"
set "REASON=child-exit"
goto finalize

:fail_arch
set "REASON=not-x64"
:fail_platform
set "RC=2"
goto finalize
:fail_list_hash
set "RC=2"
set "STAGE=integrity"
set "REASON=critical-list-hash"
goto finalize
:fail_file_hash
set "RC=2"
set "STAGE=integrity"
set "REASON=critical-file-hash"
goto finalize
:fail_unsafe_path
set "RC=2"
set "STAGE=integrity"
set "REASON=unsafe-path"
goto finalize
:fail_lock_live
set "REASON=lock-owner-live"
goto fail_lock
:fail_lock_unknown
set "REASON=lock-owner-unverifiable"
goto fail_lock
:fail_lock_prepare
set "REASON=lock-create-failed"
:fail_lock
set "RC=2"
set "STAGE=lock"
goto finalize
:fail_payload
set "RC=2"
set "STAGE=verifier"
set "REASON=invalid-verifier-payload"
goto finalize
:fail_native
set "REASON=native-tool-missing"
goto fail_bootstrap
:fail_download
set "REASON=download-failed"
goto fail_bootstrap
:fail_redirect
set "REASON=redirect-host"
goto fail_bootstrap
:fail_checksum
set "REASON=download-hash"
goto fail_bootstrap
:fail_extract
set "REASON=extract-failed"
goto fail_bootstrap
:fail_runtime
set "REASON=runtime-check-failed"
:fail_bootstrap
set "RC=3"
set "STAGE=runtime"
goto finalize
:fail_package_manager
set "RC=3"
set "STAGE=package-manager"
set "REASON=install-failed"

:finalize
call :cleanup_files
if not "%RC%"=="0" goto report_failure
echo BOOTSTRAP_READY cleanup=true
goto finish
:report_failure
echo BOOTSTRAP_FAIL stage=%STAGE% reason=%REASON% retry=true
:finish
if defined PUSHED popd
endlocal & exit /b %RC%

:hash_file
set "ACTUAL_SHA256="
for /f "skip=1 delims=" %%H in ('%SYSTEM_NATIVE%\certutil.exe -hashfile "%HASH_PATH%" SHA256 2^>nul') do if not defined ACTUAL_SHA256 set "ACTUAL_SHA256=%%H"
if not defined ACTUAL_SHA256 exit /b 0
set "ACTUAL_SHA256=%ACTUAL_SHA256: =%"
exit /b 0

:plain_path
set "ANCESTOR=%CHECK_PATH%"
:plain_ancestor
set "CHECK_ATTRIBUTES="
for %%P in ("%ANCESTOR%") do set "CHECK_ATTRIBUTES=%%~aP"
if not defined CHECK_ATTRIBUTES goto next_ancestor
if not "%CHECK_ATTRIBUTES:l=%"=="%CHECK_ATTRIBUTES%" exit /b 1
:next_ancestor
for %%P in ("%ANCESTOR%\..") do set "NEXT_ANCESTOR=%%~fP"
if /I "%NEXT_ANCESTOR%"=="%ANCESTOR%" exit /b 0
set "ANCESTOR=%NEXT_ANCESTOR%"
goto plain_ancestor

:acquire_lock
if defined OWN_LOCK exit /b 0
set "CHECK_PATH=%LOCK_DIR%"
call :plain_path
if errorlevel 1 exit /b 1
if exist "%LOCK_DIR%" exit /b 1
mkdir "%LOCK_STAGE%" 2>nul
if errorlevel 1 exit /b 1
copy /b "%OWNER_RECORD%" "%LOCK_STAGE%\owner.txt" >nul 2>nul
if errorlevel 1 exit /b 1
rem REN cannot merge into an existing directory (unlike MOVE).
ren "%LOCK_STAGE%" bootstrap.lock 2>nul
if errorlevel 1 exit /b 1
set "OWN_LOCK=1"
call :check_owner
if not errorlevel 1 exit /b 1
if errorlevel 2 exit /b 1
exit /b 0

:critical_file
set "EXPECTED_FILE_HASH=%CRITICAL_LINE:~0,64%"
set "CRITICAL_REL=%CRITICAL_LINE:~66%"
if not "%CRITICAL_LINE:~64,2%"=="  " exit /b 1
if "%EXPECTED_FILE_HASH:~63,1%"=="" exit /b 1
if not "%EXPECTED_FILE_HASH:~64,1%"=="" exit /b 1
for /f "delims=0123456789abcdef" %%H in ("%EXPECTED_FILE_HASH%") do exit /b 1
if not defined CRITICAL_REL exit /b 1
for /f "delims=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_./-" %%P in ("%CRITICAL_REL%") do exit /b 1
if not "%CRITICAL_REL:..=%"=="%CRITICAL_REL%" exit /b 1
if "%CRITICAL_REL:~0,1%"=="/" exit /b 1
for %%P in ("%CRITICAL_REL%") do if defined HVE_CRITICAL_SEEN_%%~P exit /b 1
set "HVE_CRITICAL_SEEN_%CRITICAL_REL%=1"
set "HASH_PATH=%ROOT%\%CRITICAL_REL:/=\%"
set "CHECK_PATH=%HASH_PATH%"
call :plain_path
if errorlevel 1 exit /b 1
if not exist "%HASH_PATH%" exit /b 1
call :hash_file
if /I not "%ACTUAL_SHA256%"=="%EXPECTED_FILE_HASH%" exit /b 1
exit /b 0

:critical_set
if not "%CRITICAL_COUNT%"=="13" exit /b 1
for %%P in (hve-bootstrap-manifest.json pyproject.toml hve/__init__.py hve/bootstrap_verify.py hve/startup_version.py hve/auth.py hve/gui/copilot_cli_bridge.py hve/gui/pty_backend.py hve/bootstrap/bootstrap-sources.json hve/setup-hve.ps1 Start-HVE.ps1 hve/bootstrap/windows-pwsh-runtime-check.ps1 hve/bootstrap/winget-module-inspect.ps1) do if not defined HVE_CRITICAL_SEEN_%%P exit /b 1
exit /b 0

:check_owner
set "CHECK_PATH=%LOCK_DIR%"
call :plain_path
if errorlevel 1 exit /b 2
set "CHECK_PATH=%OWNER_FILE%"
call :plain_path
if errorlevel 1 exit /b 2
if not exist "%OWNER_FILE%" exit /b 2
set "LOCK_PID="
set "PID_COUNT=0"
set "TIME_COUNT=0"
set "OWNER_LINES=0"
for /f "tokens=2 delims==" %%P in ('%SYSTEM_NATIVE%\findstr.exe /R /X /C:"PID=[1-9][0-9]*" "%OWNER_FILE%" 2^>nul') do (
    set "LOCK_PID=%%P"
    set /a PID_COUNT+=1 >nul
)
for /f "delims=" %%T in ('%SYSTEM_NATIVE%\findstr.exe /R /X /C:"STARTED_UTC=[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z" "%OWNER_FILE%" 2^>nul') do set /a TIME_COUNT+=1 >nul
for /f "delims=" %%L in ('%SYSTEM_NATIVE%\findstr.exe /R /N "^" "%OWNER_FILE%" 2^>nul') do set /a OWNER_LINES+=1 >nul
if not "%PID_COUNT%:%TIME_COUNT%:%OWNER_LINES%"=="1:1:2" exit /b 2
set "OWNER_LIVE="
set "TASKLIST_OK="
for /f "tokens=1,2 delims=," %%P in ('%SYSTEM_NATIVE%\tasklist.exe /fi "PID eq %LOCK_PID%" /fo csv /nh 2^>nul ^&^& echo HVE_TASKLIST_OK') do (
    if "%%P"=="HVE_TASKLIST_OK" set "TASKLIST_OK=1"
    if "%%~Q"=="%LOCK_PID%" set "OWNER_LIVE=1"
)
if not defined TASKLIST_OK exit /b 2
if defined OWNER_LIVE exit /b 1
exit /b 0

:lock_has_links
set "CHECK_PATH=%LOCK_DIR%"
call :plain_path
if errorlevel 1 exit /b 1
for /f "delims=" %%L in ('dir /a:l /s /b "%LOCK_DIR%" 2^>nul') do exit /b 1
exit /b 0

:lock_contents
for /f "delims=" %%L in ('dir /a /b "%LOCK_DIR%" 2^>nul') do if not "%%L"=="owner.txt" if not "%%L"=="reap.lock" exit /b 1
exit /b 0

:retire_lock
set "CHECK_PATH=%RETIRE_DIR%"
call :plain_path
if errorlevel 1 exit /b 1
if exist "%RETIRE_DIR%" exit /b 1
ren "%LOCK_DIR%" "%RETIRE_NAME%" >nul 2>nul
if errorlevel 1 exit /b 1
if exist "%LOCK_DIR%" exit /b 1
rmdir /s /q "%RETIRE_DIR%" 2>nul
if exist "%RETIRE_DIR%" exit /b 1
exit /b 0

:try_pwsh
if defined PWSH_EXE exit /b 0
if not exist "%CANDIDATE%" exit /b 0
"%CANDIDATE%" -NoLogo -NoProfile -File "%RUNTIME_CHECK%" -ExpectedExecutable "%CANDIDATE%" -OwnerPath "%OWNER_RECORD%" >nul 2>nul
if not errorlevel 1 set "PWSH_EXE=%CANDIDATE%"
exit /b 0

:cleanup_files
if not defined OWN_WORK exit /b 0
if not "%OWN_LOCK%"=="1" goto cleanup_attempt
set "CHECK_PATH=%LOCK_DIR%"
call :plain_path
if errorlevel 1 goto cleanup_failed
call :lock_has_links
if errorlevel 1 goto cleanup_failed
call :lock_contents
if errorlevel 1 goto cleanup_failed
"%SYSTEM_NATIVE%\fc.exe" /b "%OWNER_RECORD%" "%OWNER_FILE%" >nul 2>nul
if errorlevel 1 goto cleanup_failed
call :retire_lock
if errorlevel 1 goto cleanup_failed
:cleanup_attempt
set "CHECK_PATH=%WORK_DIR%"
call :plain_path
if errorlevel 1 goto cleanup_failed
for /f "delims=" %%L in ('dir /a:l /s /b "%WORK_DIR%" 2^>nul') do goto cleanup_failed
if defined ZIP_PATH if exist "%ZIP_PATH%" del /q "%ZIP_PATH%" 2>nul
if defined PROBE_DIR if exist "%PROBE_DIR%" rmdir /s /q "%PROBE_DIR%" 2>nul
if defined PROBE_DIR if exist "%PROBE_DIR%" goto cleanup_failed
set "CHECK_PATH=%LOCK_STAGE%"
call :plain_path
if errorlevel 1 goto cleanup_failed
if exist "%LOCK_STAGE%\owner.txt" del /q "%LOCK_STAGE%\owner.txt" 2>nul
if exist "%LOCK_STAGE%" rmdir "%LOCK_STAGE%" 2>nul
if exist "%LOCK_STAGE%" goto cleanup_failed
for %%F in (owner.txt owner.txt.tmp verifier.json verifier-state.txt) do if exist "%WORK_DIR%\%%F" del /q "%WORK_DIR%\%%F" 2>nul
rmdir "%WORK_DIR%" 2>nul
if exist "%WORK_DIR%" goto cleanup_failed
exit /b 0
:cleanup_failed
set "RC=3"
set "STAGE=cleanup"
set "REASON=cleanup-failed"
exit /b 0